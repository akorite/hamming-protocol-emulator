[tasks]
bmc
prove
cover

[options]
# The leaf router and optional LUT registers are one-cycle structures; the
# input filter needs four samples.  Depth 12 covers the complete input-to-pin
# path plus replay-entry/exit and re-reset witnesses.
bmc: mode bmc
bmc: depth 12
prove: mode prove
prove: depth 8
cover: mode cover
cover: depth 12

[engines]
smtbmc bitwuzla

[script]
read -formal hamming_lut_matrix.v
prep -top hamming_lut_matrix
# Reports any accidental combinational loop in the flattened formal model.
check

[files]
../src/hamming_lut_matrix.v
