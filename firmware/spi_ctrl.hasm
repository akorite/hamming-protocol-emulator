; SPDX-License-Identifier: Apache-2.0
;
; Hamming baseline SPI controller firmware.  Mailbox: byte1 status, byte2
; config (mode in [1:0], 10 MHz in bit4), TX bytes 8..9, RX bytes 0x40...
; SCLK=core bit0, CS_N=core bit2, MOSI=BCU1 tx_p, MISO enters BCU1 via LUT.
;
; Deliberate 10 MHz cache layout: each fast mode occupies a 16-slot-aligned
; block.  The repeated six-instruction clock loop starts at the boundary and
; uses cache indices 0..2 (ret/prewarm call share index 3).  The four lead-in
; instructions after the prewarm return use indices 4..5.  The mode-specific
; clock-entry prologues are placed at slots 12 modulo 16, hence indices 6..7.
; Every index is therefore unique: prewarming leaves the loop, lead-in, and
; entry prologue simultaneously resident, and the real 10 MHz burst never
; misses in its steady loop.  The lead-in rewrites ctrl 0x01 after prewarm,
; resetting RX/DPLL state while keeping TX armed.  CPHA=1 entries drive only
; the first shift edge; RX is then armed in the loop's first post-shift timing
; slot.  That makes the free-running DPLL sample near the end of each MISO
; cell, absorbing target output-delay plus the two-cycle input synchronizer,
; without adding any clock-period padding.  Re-writing the same ctrl value in
; later loop iterations is harmless because the arm is a level, not a rephase.
;
.protocol spi_controller @clk 60MHz
.bcu mode=nrz, stuff=off, transfer=8bits_msb_first, period=@baud(10000000)
.constraint spi_clock_period = 6 cycles at 10MHz, 60 cycles at 1MHz


spi_ctrl_entry:
    ldi8.l r3, 2
    ld_dmem_b r0, [r3]
    ldi8.l r1, 0x10
    and r1, r0
    jz spi_slow_select_cpol
    jmp spi_fast_select_cpol
spi_fast_select_cpol:
    ldi8.l r1, 2
    and r1, r0
    jz spi_fast_select_cpha0
    jmp spi_fast_select_cpha1
spi_fast_select_cpha0:
    ldi8.l r1, 1
    and r1, r0
    jz spi_fast_m0_setup
    jmp spi_fast_m1_setup
spi_fast_select_cpha1:
    ldi8.l r1, 1
    and r1, r0
    jz spi_fast_m2_setup
    jmp spi_fast_m3_setup
spi_slow_select_cpol:
    ldi8.l r2, 27
    ldi8.l r1, 2
    and r1, r0
    jz spi_slow_select_cpha0
    jmp spi_slow_select_cpha1
spi_slow_select_cpha0:
    ldi8.l r1, 1
    and r1, r0
    jz spi_slow_m0_setup
    jmp spi_slow_m1_setup
spi_slow_select_cpha1:
    ldi8.l r1, 1
    and r1, r0
    jz spi_slow_m2_setup
    jmp spi_slow_m3_setup


spi_fast_m0_setup:
    bcu_ctrl 0x20
    bcu_ctrl 0x00
    pin_oe 0x1, 0x1
    pin_out 0x5, 0x4
    ldi8.l r3, 8
    ld_dmem_b r0, [r3]
    call spi_fast_m0_byte
    ldi8.l r3, 0x40
    st_dmem_b r0, [r3]
    ldi8.l r3, 9
    ld_dmem_b r0, [r3]
    call spi_fast_m0_byte
    ldi8.l r3, 0x41
    st_dmem_b r0, [r3]
    jmp spi_ctrl_done
spi_fast_m0_byte:
    bcu_ctrl 0x00
    bcu_ctrl 0x20
    bcu_ctrl 0x01
    jmp spi_fast_m0_prewarm

spi_fast_m1_setup:
    bcu_ctrl 0x20
    bcu_ctrl 0x00
    pin_oe 0x1, 0x1
    pin_out 0x5, 0x4
    ldi8.l r3, 8
    ld_dmem_b r0, [r3]
    call spi_fast_m1_byte
    ldi8.l r3, 0x40
    st_dmem_b r0, [r3]
    ldi8.l r3, 9
    ld_dmem_b r0, [r3]
    call spi_fast_m1_byte
    ldi8.l r3, 0x41
    st_dmem_b r0, [r3]
    jmp spi_ctrl_done
spi_fast_m1_byte:
    bcu_ctrl 0x00
    bcu_ctrl 0x20
    bcu_ctrl 0x01
    jmp spi_fast_m1_prewarm

spi_fast_m2_setup:
    bcu_ctrl 0x20
    bcu_ctrl 0x00
    pin_oe 0x1, 0x1
    pin_out 0x5, 0x5
    ldi8.l r3, 8
    ld_dmem_b r0, [r3]
    call spi_fast_m2_byte
    ldi8.l r3, 0x40
    st_dmem_b r0, [r3]
    ldi8.l r3, 9
    ld_dmem_b r0, [r3]
    call spi_fast_m2_byte
    ldi8.l r3, 0x41
    st_dmem_b r0, [r3]
    jmp spi_ctrl_done
spi_fast_m2_byte:
    bcu_ctrl 0x00
    bcu_ctrl 0x20
    bcu_ctrl 0x01
    jmp spi_fast_m2_prewarm

spi_fast_m3_setup:
    bcu_ctrl 0x20
    bcu_ctrl 0x00
    pin_oe 0x1, 0x1
    pin_out 0x5, 0x5
    ldi8.l r3, 8
    ld_dmem_b r0, [r3]
    call spi_fast_m3_byte
    ldi8.l r3, 0x40
    st_dmem_b r0, [r3]
    ldi8.l r3, 9
    ld_dmem_b r0, [r3]
    call spi_fast_m3_byte
    ldi8.l r3, 0x41
    st_dmem_b r0, [r3]
    jmp spi_ctrl_done
spi_fast_m3_byte:
    bcu_ctrl 0x00
    bcu_ctrl 0x20
    bcu_ctrl 0x01
    jmp spi_fast_m3_prewarm

spi_ctrl_done:
    ldi8.l r3, 2
    ld_dmem_b r0, [r3]
    ldi8.l r1, 2
    and r1, r0
    jz spi_done_cpol0
    pin_out 0x5, 0x5
    jmp spi_done_release
spi_done_cpol0:
    pin_out 0x5, 0x4
spi_done_release:
    bcu_ctrl 0x00
    pin_oe 0x1, 0x0
    ldi8.l r3, 1
    ldi8.l r0, 1
    st_dmem_b r0, [r3]
    halt


.org 192
spi_fast_m0_clock8:
    pin_out 0x1, 0x1
    nop
spi_fast_m0_clock8_second:
    pin_out 0x1, 0x0
    nop
    dec r1
    jnz spi_fast_m0_clock8
    ret
spi_fast_m0_prewarm:
    call spi_fast_m0_entry
spi_fast_m0_start:
    pin_out 0x5, 0x0
    bcu_ctrl 0x01
    bcu_tx r0
    call spi_fast_m0_entry
    bcu_rx r0
    pin_out 0x5, 0x4
    ret


.org 208
spi_fast_m1_clock8:
    pin_out 0x1, 0x1
    nop
spi_fast_m1_clock8_second:
    pin_out 0x1, 0x0
    bcu_ctrl 0x03           ; first pass arms RX late in bit0's cell
    dec r1
    jnz spi_fast_m1_clock8
    ret
spi_fast_m1_prewarm:
    call spi_fast_m1_entry
spi_fast_m1_start:
    pin_out 0x5, 0x0
    bcu_ctrl 0x01
    bcu_tx r0
    call spi_fast_m1_entry
    bcu_rx r0
    pin_out 0x5, 0x4
    ret


.org 224
spi_fast_m2_clock8:
    pin_out 0x1, 0x0
    nop
spi_fast_m2_clock8_second:
    pin_out 0x1, 0x1
    nop
    dec r1
    jnz spi_fast_m2_clock8
    ret
spi_fast_m2_prewarm:
    call spi_fast_m2_entry
spi_fast_m2_start:
    pin_out 0x5, 0x1
    bcu_ctrl 0x01
    bcu_tx r0
    call spi_fast_m2_entry
    bcu_rx r0
    pin_out 0x5, 0x5
    ret


.org 240
spi_fast_m3_clock8:
    pin_out 0x1, 0x0
    nop
spi_fast_m3_clock8_second:
    pin_out 0x1, 0x1
    bcu_ctrl 0x03           ; first pass arms RX late in bit0's cell
    dec r1
    jnz spi_fast_m3_clock8
    ret
spi_fast_m3_prewarm:
    call spi_fast_m3_entry
spi_fast_m3_start:
    pin_out 0x5, 0x1
    bcu_ctrl 0x01
    bcu_tx r0
    call spi_fast_m3_entry
    bcu_rx r0
    pin_out 0x5, 0x5
    ret


.org 268
spi_fast_m0_entry:
    bcu_ctrl 0x03
    ldi8.l r1, 8
    jmp spi_fast_m0_clock8

.org 284
spi_fast_m1_entry:
    ldi8.l r1, 8
    pin_out 0x1, 0x1
    jmp spi_fast_m1_clock8_second

.org 300
spi_fast_m2_entry:
    bcu_ctrl 0x03
    ldi8.l r1, 8
    jmp spi_fast_m2_clock8

.org 316
spi_fast_m3_entry:
    ldi8.l r1, 8
    pin_out 0x1, 0x0
    jmp spi_fast_m3_clock8_second


.org 336

spi_slow_m0_setup:
    bcu_ctrl 0x20
    bcu_ctrl 0x00
    pin_oe 0x1, 0x1
    pin_out 0x5, 0x4
    ldi8.l r3, 8
    ld_dmem_b r0, [r3]
    call spi_slow_m0_byte
    ldi8.l r3, 0x40
    st_dmem_b r0, [r3]
    ldi8.l r3, 9
    ld_dmem_b r0, [r3]
    call spi_slow_m0_byte
    ldi8.l r3, 0x41
    st_dmem_b r0, [r3]
    jmp spi_ctrl_done
spi_slow_m0_byte:
    bcu_ctrl 0x00
    bcu_ctrl 0x20
    bcu_ctrl 0x01
    jmp spi_slow_m0_prewarm

spi_slow_m1_setup:
    bcu_ctrl 0x20
    bcu_ctrl 0x00
    pin_oe 0x1, 0x1
    pin_out 0x5, 0x4
    ldi8.l r3, 8
    ld_dmem_b r0, [r3]
    call spi_slow_m1_byte
    ldi8.l r3, 0x40
    st_dmem_b r0, [r3]
    ldi8.l r3, 9
    ld_dmem_b r0, [r3]
    call spi_slow_m1_byte
    ldi8.l r3, 0x41
    st_dmem_b r0, [r3]
    jmp spi_ctrl_done
spi_slow_m1_byte:
    bcu_ctrl 0x00
    bcu_ctrl 0x20
    bcu_ctrl 0x01
    jmp spi_slow_m1_prewarm

spi_slow_m2_setup:
    bcu_ctrl 0x20
    bcu_ctrl 0x00
    pin_oe 0x1, 0x1
    pin_out 0x5, 0x5
    ldi8.l r3, 8
    ld_dmem_b r0, [r3]
    call spi_slow_m2_byte
    ldi8.l r3, 0x40
    st_dmem_b r0, [r3]
    ldi8.l r3, 9
    ld_dmem_b r0, [r3]
    call spi_slow_m2_byte
    ldi8.l r3, 0x41
    st_dmem_b r0, [r3]
    jmp spi_ctrl_done
spi_slow_m2_byte:
    bcu_ctrl 0x00
    bcu_ctrl 0x20
    bcu_ctrl 0x01
    jmp spi_slow_m2_prewarm

spi_slow_m3_setup:
    bcu_ctrl 0x20
    bcu_ctrl 0x00
    pin_oe 0x1, 0x1
    pin_out 0x5, 0x5
    ldi8.l r3, 8
    ld_dmem_b r0, [r3]
    call spi_slow_m3_byte
    ldi8.l r3, 0x40
    st_dmem_b r0, [r3]
    ldi8.l r3, 9
    ld_dmem_b r0, [r3]
    call spi_slow_m3_byte
    ldi8.l r3, 0x41
    st_dmem_b r0, [r3]
    jmp spi_ctrl_done
spi_slow_m3_byte:
    bcu_ctrl 0x00
    bcu_ctrl 0x20
    bcu_ctrl 0x01
    jmp spi_slow_m3_prewarm


.org 448

spi_slow_m0_prewarm:
    call spi_slow_m0_clock8
spi_slow_m0_start:
    pin_out 0x5, 0x0
    bcu_ctrl 0x01
    bcu_tx r0
    call spi_slow_m0_clock8
    bcu_rx r0
    pin_out 0x5, 0x4
    ret
spi_slow_m0_clock8:
    bcu_ctrl 0x03
    ldi8.l r1, 8
spi_slow_m0_clock8_loop:
    pin_out 0x1, 0x1
    set_anchor 0
    wait_phase r2
    pin_out 0x1, 0x0
    set_anchor 0
    wait_phase r2
    dec r1
    jnz spi_slow_m0_clock8_loop
    ret


spi_slow_m1_prewarm:
    call spi_slow_m1_clock8
spi_slow_m1_start:
    pin_out 0x5, 0x0
    bcu_ctrl 0x01
    bcu_tx r0
    call spi_slow_m1_clock8
    bcu_rx r0
    pin_out 0x5, 0x4
    ret
spi_slow_m1_clock8:
    ldi8.l r1, 8
    pin_out 0x1, 0x1
    bcu_ctrl 0x03
    set_anchor 0
    wait_phase r2
    pin_out 0x1, 0x0
    set_anchor 0
    wait_phase r2
    dec r1
    jnz spi_slow_m1_clock8_steady
spi_slow_m1_clock8_steady:
    pin_out 0x1, 0x1
    set_anchor 0
    wait_phase r2
    pin_out 0x1, 0x0
    set_anchor 0
    wait_phase r2
    dec r1
    jnz spi_slow_m1_clock8_steady
    ret


spi_slow_m2_prewarm:
    call spi_slow_m2_clock8
spi_slow_m2_start:
    pin_out 0x5, 0x1
    bcu_ctrl 0x01
    bcu_tx r0
    call spi_slow_m2_clock8
    bcu_rx r0
    pin_out 0x5, 0x5
    ret
spi_slow_m2_clock8:
    bcu_ctrl 0x03
    ldi8.l r1, 8
spi_slow_m2_clock8_loop:
    pin_out 0x1, 0x0
    set_anchor 0
    wait_phase r2
    pin_out 0x1, 0x1
    set_anchor 0
    wait_phase r2
    dec r1
    jnz spi_slow_m2_clock8_loop
    ret


spi_slow_m3_prewarm:
    call spi_slow_m3_clock8
spi_slow_m3_start:
    pin_out 0x5, 0x1
    bcu_ctrl 0x01
    bcu_tx r0
    call spi_slow_m3_clock8
    bcu_rx r0
    pin_out 0x5, 0x5
    ret
spi_slow_m3_clock8:
    ldi8.l r1, 8
    pin_out 0x1, 0x0
    bcu_ctrl 0x03
    set_anchor 0
    wait_phase r2
    pin_out 0x1, 0x1
    set_anchor 0
    wait_phase r2
    dec r1
    jnz spi_slow_m3_clock8_steady
spi_slow_m3_clock8_steady:
    pin_out 0x1, 0x0
    set_anchor 0
    wait_phase r2
    pin_out 0x1, 0x1
    set_anchor 0
    wait_phase r2
    dec r1
    jnz spi_slow_m3_clock8_steady
    ret
