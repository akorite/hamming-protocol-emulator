; SPDX-License-Identifier: Apache-2.0
;
; Hamming baseline SPI controller firmware.
;
; Mailbox (SRAM 1 bytes):
;   1 status (1=done), 2 configuration, 8..11 four TX bytes, 0x40.. RX bytes.
;   cfg[3:0]=SPI mode 0..3, cfg[4]=1 for 10 MHz / 0 for 1 MHz.
;
; Pin plan (core1): SCLK=core_out bit0 routed to uio1, MOSI=BCU1 tx_p routed
; to uio5, CS_N=core_out bit2 routed to uo_out1, MISO enters BCU1 through LUT2.
; The host writes BCU mode/bit length/symbol period before CTRL_RUN.
;
; The 10 MHz clock burst is a six-instruction cached loop: one bit period is
; exactly six system clocks.  The 1 MHz path uses WAIT_PHASE deadlines in the
; same structural loop.  BCU serialization supplies the MOSI bit stream and
; the BCU receiver collects the simultaneous MISO byte.
;
.protocol spi_controller @clk 60MHz
.bcu mode=nrz, stuff=off, transfer=8bits_msb_first, period=@baud(10000000)
.constraint spi_clock_period = 6 cycles at 10MHz, 60 cycles at 1MHz

spi_ctrl_entry:
    ; Read configuration and select the clock-burst timing path.
    ldi8.l r3, 2
    ld_dmem_b r0, [r3]
    ldi8.l r1, 0x10
    and r1, r0
    jz spi_ctrl_slow_setup
    jmp spi_ctrl_fast_setup


; ----------------------------------------------------------------------
; Shared initialization.  CPOL is extracted from cfg bit1.  The routines
; below duplicate only the small clock loop; all byte/mailbox handling is common.
; ----------------------------------------------------------------------
spi_ctrl_fast_setup:
    ; r2 is unused by the fast loop.  Select CPOL clock resting level.
    ldi8.l r3, 2
    ld_dmem_b r0, [r3]
    ldi8.l r1, 2
    and r1, r0
    jz spi_fast_cpol0
    jmp spi_fast_cpol1

spi_ctrl_slow_setup:
    ; WAIT delta tuned so deadline+loop overhead gives a 60-cycle bit period.
    ldi8.l r2, 27
    ldi8.l r3, 2
    ld_dmem_b r0, [r3]
    ldi8.l r1, 2
    and r1, r0
    jz spi_slow_cpol0
    jmp spi_slow_cpol1


; ======================================================================
; 10 MHz CPOL=0 path
; ======================================================================
spi_fast_cpol0:
    bcu_ctrl 0x20
    bcu_ctrl 0x00
    bcu_ctrl 0x03
    pin_oe 0x1, 0x1          ; enable SCLK bit0
    pin_out 0x5, 0x4         ; CS_N high, SCLK low

    ldi8.l r3, 8
    ld_dmem_b r0, [r3]
    call spi_fast0_byte
    ldi8.l r3, 0x40
    st_dmem_b r0, [r3]

    ldi8.l r3, 9
    ld_dmem_b r0, [r3]
    call spi_fast0_byte
    ldi8.l r3, 0x41
    st_dmem_b r0, [r3]

    jmp spi_ctrl_done


; input r0=MOSI byte, returns r0=MISO byte.  r1 is the bit-loop count.
spi_fast0_byte:
    ; Rephase the free-running RX sampler for every byte.  Inter-byte
    ; mailbox/branch time is legal SPI clock idle time, but it is not a
    ; multiple of the BCU cell phase; without this reset the sampler walks.
    bcu_ctrl 0x00
    bcu_ctrl 0x20
    bcu_ctrl 0x00
    bcu_ctrl 0x03
    call spi_fast0_clock8  ; icache prewarm while CS_N is high
    pin_out 0x5, 0x0         ; CS_N low, SCLK stays low
    bcu_tx r0
    nop
    nop
    nop
    nop
    nop
    call spi_fast0_clock8
    bcu_rx r0
    pin_out 0x5, 0x4         ; end byte: CS_N high, SCLK low for CPOL=0
    ret

spi_fast0_clock8:
    ldi8.l r1, 8
spi_fast0_clock8_clk:
    pin_out 0x1, 0x1         ; rising edge
    nop
    pin_out 0x1, 0x0         ; falling edge (period is exactly 6 clocks)
    nop
    dec r1
    jnz spi_fast0_clock8_clk
    ret


; ======================================================================
; 10 MHz CPOL=1 path
; ======================================================================
spi_fast_cpol1:
    bcu_ctrl 0x20
    bcu_ctrl 0x00
    bcu_ctrl 0x03
    pin_oe 0x1, 0x1
    pin_out 0x5, 0x5         ; CS_N high, SCLK high

    ldi8.l r3, 8
    ld_dmem_b r0, [r3]
    call spi_fast1_byte
    ldi8.l r3, 0x40
    st_dmem_b r0, [r3]
    ldi8.l r3, 9
    ld_dmem_b r0, [r3]
    call spi_fast1_byte
    ldi8.l r3, 0x41
    st_dmem_b r0, [r3]
    jmp spi_ctrl_done

spi_fast1_byte:
    ; Rephase the free-running RX sampler for every byte.  Inter-byte
    ; mailbox/branch time is legal SPI clock idle time, but it is not a
    ; multiple of the BCU cell phase; without this reset the sampler walks.
    bcu_ctrl 0x00
    bcu_ctrl 0x20
    bcu_ctrl 0x00
    bcu_ctrl 0x03
    call spi_fast1_clock8  ; icache prewarm while CS_N is high
    pin_out 0x5, 0x1         ; CS_N low, SCLK stays high
    bcu_tx r0
    nop
    nop
    nop
    nop
    nop
    call spi_fast1_clock8
    bcu_rx r0
    pin_out 0x5, 0x5         ; end byte: CS_N high, SCLK high for CPOL=1
    ret

spi_fast1_clock8:
    ldi8.l r1, 8
spi_fast1_clock8_clk:
    pin_out 0x1, 0x0         ; falling edge
    nop
    pin_out 0x1, 0x1         ; rising edge, exact 6-cycle period
    nop
    dec r1
    jnz spi_fast1_clock8_clk
    ret


; ======================================================================
; 1 MHz paths (same pin polarity structure, deadline-timed clock loop)
; ======================================================================
spi_slow_cpol0:
    bcu_ctrl 0x20
    bcu_ctrl 0x00
    bcu_ctrl 0x03
    pin_oe 0x1, 0x1
    pin_out 0x5, 0x4
    ldi8.l r3, 8
    ld_dmem_b r0, [r3]
    call spi_slow0_byte
    ldi8.l r3, 0x40
    st_dmem_b r0, [r3]
    ldi8.l r3, 9
    ld_dmem_b r0, [r3]
    call spi_slow0_byte
    ldi8.l r3, 0x41
    st_dmem_b r0, [r3]
    jmp spi_ctrl_done

spi_slow0_byte:
    ; Rephase the free-running RX sampler for every byte.  Inter-byte
    ; mailbox/branch time is legal SPI clock idle time, but it is not a
    ; multiple of the BCU cell phase; without this reset the sampler walks.
    bcu_ctrl 0x00
    bcu_ctrl 0x20
    bcu_ctrl 0x00
    bcu_ctrl 0x03
    call spi_slow0_clock8  ; icache prewarm while CS_N is high
    pin_out 0x5, 0x0
    bcu_tx r0
    call spi_slow0_clock8
    bcu_rx r0
    pin_out 0x5, 0x4         ; end byte: CS_N high, SCLK low for CPOL=0
    ret

spi_slow0_clock8:
    ldi8.l r1, 8
spi_slow0_clock8_clk:
    pin_out 0x1, 0x1
    set_anchor 0
    wait_phase r2
    pin_out 0x1, 0x0
    set_anchor 0
    wait_phase r2
    dec r1
    jnz spi_slow0_clock8_clk
    ret


spi_slow_cpol1:
    bcu_ctrl 0x20
    bcu_ctrl 0x00
    bcu_ctrl 0x03
    pin_oe 0x1, 0x1
    pin_out 0x5, 0x5
    ldi8.l r3, 8
    ld_dmem_b r0, [r3]
    call spi_slow1_byte
    ldi8.l r3, 0x40
    st_dmem_b r0, [r3]
    ldi8.l r3, 9
    ld_dmem_b r0, [r3]
    call spi_slow1_byte
    ldi8.l r3, 0x41
    st_dmem_b r0, [r3]
    jmp spi_ctrl_done

spi_slow1_byte:
    ; Rephase the free-running RX sampler for every byte.  Inter-byte
    ; mailbox/branch time is legal SPI clock idle time, but it is not a
    ; multiple of the BCU cell phase; without this reset the sampler walks.
    bcu_ctrl 0x00
    bcu_ctrl 0x20
    bcu_ctrl 0x00
    bcu_ctrl 0x03
    call spi_slow1_clock8  ; icache prewarm while CS_N is high
    pin_out 0x5, 0x1
    bcu_tx r0
    call spi_slow1_clock8
    bcu_rx r0
    pin_out 0x5, 0x5         ; end byte: CS_N high, SCLK high for CPOL=1
    ret

spi_slow1_clock8:
    ldi8.l r1, 8
spi_slow1_clock8_clk:
    pin_out 0x1, 0x0
    set_anchor 0
    wait_phase r2
    pin_out 0x1, 0x1
    set_anchor 0
    wait_phase r2
    dec r1
    jnz spi_slow1_clock8_clk
    ret


spi_ctrl_done:
    ; Restore CS_N high while preserving the mode's clock idle polarity.
    ldi8.l r3, 2
    ld_dmem_b r0, [r3]
    ldi8.l r1, 2
    and r1, r0
    jz spi_done_cpol0
    pin_out 0x5, 0x5
    jmp spi_done_release
spi_done_cpol0:
    pin_out 0x5, 0x4
spi_done_release:
    bcu_ctrl 0x00
    pin_oe 0x1, 0x0
    ldi8.l r3, 1
    ldi8.l r0, 1
    st_dmem_b r0, [r3]
    halt
