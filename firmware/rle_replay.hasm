; SPDX-License-Identifier: Apache-2.0
;
; Hamming RLE capture/replay demo firmware - the replay half.
;
; The demo contract is split between hardware and firmware:
;   capture: the RLE engine (no firmware involvement) timestamp-compresses
;            the raw UART wire on ui_in[0] (probe bit 8) into the SRAM1 ring
;            as {delta[15:0], probe[15:0]} records.
;   replay:  the host decodes the ring, resamples the waveform at the UART
;            bit-cell grid, packs the bitstream into 16-bit push words, and
;            writes them into the SRAM1 playback buffer.  This firmware then
;            streams the buffer through the BCU NRZ serializer, regenerating
;            the original UART traffic on uio0.
;
; Honest architectural limitation, documented rather than hidden: the BCU
; has no raw infinite-rate playback mode.  Replay therefore runs at the
; BCU-generated bit timing (one bit per 20-cycle symbol cell), which
; reproduces the captured UART payload bit-exactly but does not reproduce
; arbitrary per-edge dwell times the way the RLE engine's own hardware
; replay mode (RLE_CTRL mode=2, replay_data through pin-router source 2)
; would.  For asynchronous UART this distinction is invisible to the
; downstream receiver, which re-locks on every start edge anyway; the test
; verifies payload content and framing, and separately verifies capture
; fidelity at the RLE engine's own clock granularity.
;
; Memory mailbox (SRAM 1 byte addresses):
;   1    status: 1 = playback complete
;   2    push count P: number of 16-bit BCU words to stream (host writes)
;   0x40.. playback byte pairs: push i low byte at 0x40+2i, high byte at
;        0x40+2i+1.  Bit j of the combined 16-bit word is wire bit 16i+j
;        (BCU len16 LSB-first emits bit0 first), padded with idle ones.
;
; Pin plan used by the test:
;   downstream/replay TX: uio0 data/OE <- BCU0 tx_p/tx_oe through the router
;   (the capture half needs no LUT/router setup at all - the RLE engine
;    probes the synchronized pin inputs directly)
;
; Streaming discipline: the BCU TX path has a single shadow word.  Each push
; covers 16 bits = 320 symbol clocks, while one firmware loop iteration
; costs well under 60 cycles, so pacing only needs the tx_empty shadow-free
; poll below.  On the first iteration the serializer is idle, tx_empty is
; already set, and the push starts the stream immediately; afterwards the
; poll releases exactly when the previous word is pulled from the shadow,
; so the wire stream is gapless and the shadow is never overwritten while
; still pending.
;
; ORCHESTRATOR-CHECK: if the host ever wrote push count 0 the loop would
; underflow; the demo test always writes count >= 1 (host contract).
; ORCHESTRATOR-CHECK: exact first-bit latency after the first bcu_tx push is
; a couple of clock cycles inside the BCU; asynchronous UART tolerates it
; because the receiver locks on the start edge itself.
;
; Instruction budget: ~35 slots of the 1024-slot image.

.protocol rle_capture_replay @clk 60MHz
.bcu mode=nrz, stuff=off, transfer=16bits_lsb_first, dpll=none(@baud(3000000))
.constraint replay_bit_period = @baud(3000000) cycles from the BCU symbol clock

replay_entry:
    ; Architected core dispatch: core0 streams playback; other cores halt.
    csr_rd r1, 0x4d
    mov r1, r1
    jz replay_engine
    halt

replay_engine:
    ; Soft-reset the BCU, then arm TX only.  Host CSR setup supplies:
    ; codec=nrz, len=16, LSB-first, DPLL mode=none period=@baud(3000000)=20
    ; (the DPLL period register doubles as the TX symbol clock).
    bcu_ctrl 0x20
    bcu_ctrl 0x00
    bcu_ctrl 0x01              ; tx_arm

    ; r2 = playback push count (mailbox byte 2)
    ldi8.l r3, 2
    ld_dmem_b r2, [r3]
    ; r3 = playback byte-pair pointer (byte addressing) at 0x40
    ldi8.l r3, 0x40
    ldi8.h r3, 0

rp_loop:
    ; Wait for the TX shadow slot to be free (tx_empty = BCU status bit4).
    ldi8.l r1, 0x10
rp_wait_empty:
    bcu_stat r0
    and r0, r1
    jz rp_wait_empty

    ; Load one byte pair and combine: r0 = lo | (hi << 8).
    ld_dmem_b r0, [r3]
    ld_dmem_b r1, [r3+1]
    shl r1
    shl r1
    shl r1
    shl r1
    shl r1
    shl r1
    shl r1
    shl r1
    or r0, r1
    bcu_tx r0                  ; 16 wire bits, bit0 emitted first
    inc r3
    inc r3                     ; advance to the next byte pair
    dec r2
    jnz rp_loop

    ; Success status=1 at byte address 1.
    ldi8.l r3, 1
    ldi8.l r0, 1
    st_dmem_b r0, [r3]
    halt
